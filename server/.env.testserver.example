# Copy to server/.env.testserver. Never commit the copy.
#
# The API pointed at the TEST database, for driving document flows against data
# that is safe to create, post and cancel. `npm run dev:test` in server/ reads
# this file; the front end that talks to it is `npm run dev:test` in the project
# root, which reads .env.test and serves on 5292.
#
# Never point this at development or production. NODE_ENV=test makes the app
# resolve TEST_DATABASE_URL, and DATABASE_ENV=test lets db:reset and db:fresh
# run against it without an override -- both of which are wrong for any database
# whose contents somebody would miss.

NODE_ENV=test
DATABASE_ENV=test
PORT=5320

# The test database, and only the test database. The app reads this one as
# DATABASE_URL because NODE_ENV=test; there is no separate TEST_DATABASE_URL
# here.
DATABASE_URL=postgres://business_suite:CHANGE_ME@127.0.0.1:5432/business_suite_test

# Its own secret, not the one in .env. db:fresh rotates the secret belonging to
# the database it reset, so a shared value would mean resetting the test
# database signed every development session out.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# CORS_ORIGINS, plural. config.js reads that name and no other, so the singular
# sets nothing at all: the API silently falls back to the development ports and
# refuses every request from the test front end on 5292, with the browser
# reporting only that the origin was not allowed. This file had the singular
# once and it cost an afternoon to find.
CORS_ORIGINS=http://localhost:5292
