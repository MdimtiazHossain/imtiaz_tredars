# Copy to server/.env and fill in. Never commit .env.

# --- database -------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://business_suite:CHANGE_ME@127.0.0.1:5432/business_suite
# Separate database used by `npm test`; integration tests are skipped without it.
TEST_DATABASE_URL=postgres://business_suite:CHANGE_ME@127.0.0.1:5432/business_suite_test
DB_POOL_MAX=10

# --- security -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- export ---------------------------------------------------------------
# PDF export uses a Latin-1 font unless you point this at a .ttf covering the
# scripts you need (e.g. Noto Sans Bengali). Excel is UTF-8 regardless.
PDF_FONT_PATH=

# --- server ---------------------------------------------------------------
NODE_ENV=development
PORT=5310
CORS_ORIGINS=http://localhost:5173,http://localhost:5290
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
ORG_ID=1
