# Copy to server/.env and fill in. Never commit .env.
#
# For the API pointed at the test database -- `npm run dev:test` -- copy
# .env.testserver.example to .env.testserver instead. It is a separate file
# rather than a section here because the two run at once, on different ports,
# against different databases.

# --- database -------------------------------------------------------------
# What DATABASE_URL points at: development | test | production.
# Destructive commands (db:reset, db:fresh) read this: they run freely against
# test, need an explicit override against development, and are refused outright
# against production. An unset or unrecognised value is treated as production,
# because guessing wrong in that direction only costs a flag.
DATABASE_ENV=development
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://business_suite:CHANGE_ME@127.0.0.1:5432/business_suite
# Separate database used by `npm test`; integration tests are skipped without it.
TEST_DATABASE_URL=postgres://business_suite:CHANGE_ME@127.0.0.1:5432/business_suite_test
DB_POOL_MAX=10

# --- security -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- export ---------------------------------------------------------------
# PDF export uses a Latin-1 font unless you point this at a .ttf covering the
# scripts you need, so Bengali text exports as "?" while this is empty. Excel
# is UTF-8 regardless.
#   Windows: C:/Windows/Fonts/kalpurush.ttf   (ships with Bangla support)
#   Linux:   /usr/share/fonts/truetype/noto/NotoSansBengali-Regular.ttf
PDF_FONT_PATH=

# --- server ---------------------------------------------------------------
NODE_ENV=development
PORT=5310
CORS_ORIGINS=http://localhost:5173,http://localhost:5290
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
ORG_ID=1
