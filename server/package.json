{
  "name": "meghna-business-suite-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API and PostgreSQL data layer for the Business Suite.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:bootstrap": "node db/bootstrap.mjs",
    "db:configure": "node db/configure.mjs",
    "check:sql": "node tools/check-sql.mjs",
    "db:migrate": "node db/migrate.mjs up",
    "db:backup": "node db/backup.mjs",
    "db:reset": "node db/migrate.mjs reset",
    "db:seed": "node db/seed/seed.mjs",
    "db:setup": "node db/migrate.mjs reset && node db/seed/seed.mjs",
    "db:fresh": "node db/fresh.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "dev:test": "node --env-file=.env.testserver --watch src/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.6"
  }
}
