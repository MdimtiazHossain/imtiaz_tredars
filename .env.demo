# Demo mode: `npm run demo` runs the app with no backend at all.
#
# The app picks its repository from VITE_API_URL -- an address selects the live
# API, none selects the bundled seed data. `.env` sets that address, so without
# this file there was no way to actually start the no-backend demo the README
# describes. An empty value here overrides it for this mode only.
VITE_API_URL=
