{
  "name": "meghna-business-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Business management app for dealer and bulk crop trading operations.",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev:test": "vite --mode test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^26.4.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.6"
  }
}
